{
    "configurations": [
        

        {
            "name": "Launch Chrome",
            "request": "launch",
            "type": "chrome",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Attach to Chrome",
            "port": 9222,
            "request": "attach",
            "type": "chrome",
            "webRoot": "${workspaceFolder}"
        },
    {
        "name": "Attach to Integrated Browser",
        "request": "attach",
        "type": "editor-browser",
        "webRoot": "${workspaceFolder}"
    }
    ]
}